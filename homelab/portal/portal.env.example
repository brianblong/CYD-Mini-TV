# Copy this file to a private location named portal.env and replace blank values.
# Never commit the completed portal.env file.

PORTAL_SECRET_KEY=
ADMIN_PASSWORD_HASH=
DEVICE_HEARTBEATS_ENABLED=false

# Optional public-facing branding
SITE_TITLE=Mini TV
SITE_TAGLINE=Your photos. Your picture show.
LOCAL_DEVICE_NAME=Display 1
REMOTE_DEVICE_NAME=Display 2

# Container paths used by the application
DATA_DIR=/data
FIRMWARE_DIR=/firmware
